# XiaohongshuFetch 插件配置范本
# 请从小红书网页端 (https://www.xiaohongshu.com) 的 Cookie 中获取以下值
# 复制本文件重命名为 config.env 并填入实际值后生效

# 核心认证 Cookie（必需）
# a1 是小红书的主要设备/用户标识（约 52 位字符）
XHS_COOKIE_A1=your_a1_cookie_value_here

# web_session 是会话认证标识（通常以 040069 开头）
XHS_COOKIE_WEB_SESSION=your_web_session_cookie_value_here

# 可选 Cookie 字段
XHS_COOKIE_WEB_ID=your_web_id_here

# 完整 Cookie 字符串（推荐：如果提供，插件将优先解析此字段）
# 示例：XHS_COOKIE_FULL=a1=...; web_session=...; webId=...;
XHS_COOKIE_FULL=

# HTTP 请求超时时间（秒，默认 20）
REQUEST_TIMEOUT=20

# 浏览器内核执行体路径（可选配置）
# 支持系统 Edge、Google Chrome 或 Chromium 便携版的绝对路径。
# 如果留空，插件将自动按顺序探测 Windows 预装的 Edge、Chrome 及常见便携路径。
XHS_BROWSER_EXECUTABLE_PATH=