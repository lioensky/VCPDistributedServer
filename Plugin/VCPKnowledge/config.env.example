# VCPKnowledge 插件配置 (v2.6.0)
# 雷达每次高亮的文档数量 (默认 5)
RADAR_TOP_DOCS=5
# 每篇高亮文档定位的最佳节数 (默认 2)
RADAR_PINPOINT_CHUNKS=2
# 雷达微摘要预览字数 (默认 110)
RADAR_SNIPPET_CHARS=110
# 雷达L1坐标激活阈值 (默认 0.48，低于此值进入L0单行静默省流态)
RADAR_MIN_SCORE=0.48
# 雷达L2原文直通阈值 (默认 0.65，高于此值自动内联Top-1焦点节原文)
RADAR_INLINE_SCORE=0.65
# 新文档入库或维度切换时单轮后台自动构建路由卡片的最大篇数 (默认 12)
AUTO_SYNC_BATCH_SIZE=12
# 新文档入库构建路由卡片时是否启用轻量模型提炼高密度语义摘要 (默认 true)
AUTO_LLM_SUMMARY=true
# 用于提炼路由卡片的轻量非思考模型名 (留空则复用全局 JevModel，不可用时自动回退至规则五段采样)
ROUTER_SUMMARY_MODEL=
# 自定义知识库触发别名 (格式: 库名1:别名a,别名b;库名2:别名c,别名d)
CUSTOM_LIBRARY_ALIASES=
# 是否启用河道传播（概念共现拓扑路径奖励，借鉴 RiverMemo 浪潮拓扑，默认 true）
TOPOLOGY_PROPAGATION=true
# 河道传播路径奖励上限（tie-breaker，永不压过 BM25/向量主证据，默认 0.08）
TOPOLOGY_PATH_BONUS_MAX=0.08
# 章节目录标题在 BM25 索引中的词频加成倍数（V1 层级加权，默认 2）
TOPOLOGY_HEADING_TF_BOOST=2
# 每篇文档参与拓扑构建的 IDF Top-N 概念数上限（默认 24）
TOPOLOGY_MAX_CONCEPTS=24
# 稀疏门控：榜首基础分低于此值时才允许河道传播（资料充分不触发，默认 0.60）
TOPOLOGY_SPARSE_TOP_SCORE=0.60
# 稀疏门控：查询命中拓扑概念的最少入口数（默认 2）
TOPOLOGY_SPARSE_MIN_HITS=2
# 拓扑出流预算：每概念保留的权重 Top-K 邻居数上限（默认 32）
TOPOLOGY_MAX_OUTFLOW=32
# 自适应概念粒度的最小df封顶值（实际minDf=max(2, min(此值, √(N/50)))，默认 16）
TOPOLOGY_MIN_DF_CAP=16