# BlenderBridge 配置示例。复制为 config.env 后按需修改。
# 全部项都有内置默认值，config.env 可以只写需要改的那几行。

# ============ 桥接本体 ============

# blender-mcp 的 Streamable HTTP 地址（第一跳）。默认 6090。
# 注意：blender-mcp 启动时的 --port 必须与此一致。
BLENDER_MCP_URL=http://127.0.0.1:6090/

# 单次请求超时（毫秒）。
# 应小于 plugin-manifest.json 的 communication.timeout(70000)，留出余量。
REQUEST_TIMEOUT_MS=60000

# MCP 协议版本。
MCP_PROTOCOL_VERSION=2025-06-18

# 调试模式。
DebugMode=false


# ============ GMR 扩展（可选） ============
# 以下全部可选。删除 gmr/ 目录后这些项自动失效，桥接本体不受影响。

# --- 数据目录 ---
# 默认全部落在插件目录下的 gmr_data/，便于整体迁移或删除。
# GMR_ROOT=<插件目录>/gmr_data
# GMR_MODELS_DIR=<GMR_ROOT>/models
# GMR_JOBS_DIR=<GMR_ROOT>/jobs
# GMR_DATASETS_DIR=<GMR_ROOT>/datasets

# --- Python 解释器 ---
# 强烈建议指向装有 PyTorch 的独立 venv，勿用系统 Python。
# 训练与推理 sidecar 都用它启动。
# GMR_PYTHON=/path/to/venv/bin/python

# --- 模型配置表 ---
# 默认读 gmr/model_config.json。接入模型只需填这份表，不必改 Python 源码。
# 详见 gmr/模型接入说明.md
# GMR_MODEL_CONFIG=<插件目录>/gmr/model_config.json

# --- 推理 sidecar ---
# 与 blender-mcp 的 6090 并列，不是串联。
# 快回路（Blender 拖拽推理）由 Add-on 直连此端口，不经过 VCP。
# GMR_SIDECAR_HOST=127.0.0.1
# GMR_SIDECAR_PORT=6091
# GMR_SIDECAR_URL=http://127.0.0.1:6091/

# --- 安全 ---
# true 则 import_model 只接受 safetensors/onnx/npz。
# 这三种格式不走 pickle 反序列化，加载不受信任的文件时风险显著更低。
# GMR_REQUIRE_SAFE_FORMAT=false

# --- 超时与日志 ---
# GMR_INFER_TIMEOUT_MS=30000     # 单次推理超时
# GMR_HEALTH_TIMEOUT_MS=3000     # sidecar 健康检查超时
# GMR_LOG_TAIL_BYTES=4096        # job_status 返回的日志尾部字节数
# GMR_HTTP_VERBOSE=0             # sidecar 是否记录每条 HTTP 请求（拖拽期会很吵）