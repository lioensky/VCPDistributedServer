# GuanLan Config
# Copy this file to config.env and fill in your own settings

# Tushare API Token (required for fundamentals/capital flow/sector data)
# Register at https://tushare.pro
TUSHARE_TOKEN=your_tushare_token

# Broker commission rates (for accurate P&L calculation)
# Default: 0.00025 (0.0025%). Modify to your actual broker rate (min 5 CNY per trade)
# Stamp duty (0.1%) and transfer fee (0.001%) are national standards, no config needed
BROKER_COMMISSION_STOCK=0.00025
BROKER_COMMISSION_ETF=0.00025
