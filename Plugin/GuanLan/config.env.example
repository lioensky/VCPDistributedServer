# === Tushare 数据源（推荐）===
# 启用精确PE/PB/主力资金/板块轮动。注册 https://tushare.pro/ 获取
TUSHARE_TOKEN=

# === 券商费率（精确盈亏计算，默认万2.5最低5元）===
BROKER_COMMISSION_STOCK=0.00025
BROKER_COMMISSION_ETF=0.00025

# === 判断账本子系统（v4.3+，可选）===
# 收割哪个Agent日记里的〔JUDGE〕块（默认观澜，向后兼容）
GUANLAN_AGENT_NAME=观澜
# 该Agent的模型版本（Brier校准分组用）
GUANLAN_MODEL_VERSION=glm-5.3
# 日记目录覆盖（默认 VCPToolBox/dailynote/<AGENT_NAME>；非VCP部署指向任意目录）
# GUANLAN_DIARY_DIR=D:\MyDiaries